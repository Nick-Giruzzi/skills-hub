#!/bin/bash

isolationtag=$(vmtoolsd --cmd "info-get guestinfo.isolationtag" | cut -c1-8)
challengecode=$(vmtoolsd --cmd "info-get guestinfo.code")
hname=$challengecode-$isolationtag.challenge

# IF CHALLENGE IS IN WORKSPACE, INSTEAD OF ##CODE##, CHANGE HOSTNAME TO "workspace.<GUID>.challenge"

workspace=##code##

if [[ "$challengecode" = "$workspace" ]]; then
	hname=workspace-$isolationtag.challenge
else
	:
fi

# END OF IF STATEMENT

file="/etc/hostname"

hsname=$(cat $file)

if [ -n $hname ] && [ $hname != $hsname ]
then
	hostnamectl --pretty set-hostname $hname
	hostnamectl --static set-hostname $hname
    hostnamectl --transient set-hostname $hname
    echo 127.0.0.1 $hname > /etc/hosts
    echo 127.0.0.1 localhost >> /etc/hosts
    echo ::1 $hname >> /etc/hosts
    echo ::1 localhost >> /etc/hosts
fi


# RESTART RSYSLOG AND NETWORKMANAGER SO IT GETS THE NEW HOSTNAME
systemctl restart rsyslog
systemctl restart NetworkManager

